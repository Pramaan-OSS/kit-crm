{
  "name": "crm-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "generate": "node scripts/generate-routes.mjs",
    "lint": "node scripts/check-imports.mjs && biome check app components lib scripts src *.json *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism --exclude \".scratch/**\" --exclude \".evidence/**\"",
    "build": "node scripts/generate-routes.mjs && next build",
    "start": "next start",
    "check": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "theme": "node scripts/generate-theme.mjs",
    "walk": "node scripts/walk.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "gates:static": "node scripts/check-contract.mjs",
    "blocks:check": "node scripts/check-blocks.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.3.6",
    "pg": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@google/design.md": "0.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "yaml": "2.9.1",
    "@playwright/test": "1.64.1"
  },
  "version": "0.1.0",
  "license": "MIT"
}
